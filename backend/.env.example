# ============================================================
# File mẫu biến môi trường - Copy thành .env và điền giá trị thật
#   cp .env.example .env
# .env đã được gitignore, KHÔNG commit giá trị thật.
# ============================================================

# ------------------------ PostgreSQL ------------------------
POSTGRES_DB=store
POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me_db_password
# Chỉ cần khi DB không chạy ở localhost:5432 (vd chạy backend ngoài docker)
#DB_HOST=localhost
#DB_PORT=5432

# -------------------------- Redis ---------------------------
REDIS_PASSWORD=change_me_redis_password
#REDIS_HOST=localhost
#REDIS_PORT=6379

# -------------------------- Kafka ---------------------------
#KAFKA_BOOTSTRAP_SERVERS=localhost:9094
#KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --------------------- Mail (Gmail SMTP) --------------------
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password   # Google App Password (16 ký tự)
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587

# --------------------------- JWT ----------------------------
# Tạo bằng: openssl rand -base64 48
JWT_SIGNER_KEY=your_jwt_signer_key_base64
#JWT_ACCESS_DURATION=3600      # seconds (1 hour)
#JWT_REFRESH_DURATION=2592000  # seconds (30 days)

# ------------------------ Cloudinary ------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------ SePay Payment Gateway -------------------
SEPAY_API_KEY=your_sepay_api_key
SEPAY_BANK_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_ACCOUNT_NAME=NGUYEN VAN A
#SEPAY_BANK_CODE=MBBank
#SEPAY_BANK_NAME=MB Bank

# --------------------- Google OAuth2 ------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
#GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
