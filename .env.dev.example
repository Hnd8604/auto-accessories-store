# ============================================================
# Biến môi trường cho DEV trên máy local.
#   cp .env.dev.example .env.dev      (Windows: copy .env.dev.example .env.dev)
# .env.dev đã được gitignore, KHÔNG commit giá trị thật.
#
# File này nằm ở THƯ MỤC GỐC, cạnh docker-compose.yml đọc nó:
#   docker compose --env-file .env.dev --profile infra up -d
# run.ps1 tự truyền sẵn --env-file, và cũng nạp file này vào biến môi trường
# cho tiến trình backend (Spring Boot không tự đọc file .env).
#
# Bản sinh đôi cho production là .env.prod.example -> .env.prod, dùng bởi
# docker-compose.prod.yml trên VPS. Hai file tách biệt, đừng dùng lẫn.
# ============================================================

# ------------------------ PostgreSQL ------------------------
POSTGRES_DB=store
POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me_db_password
# Chỉ cần khi DB không chạy ở localhost:5432 (vd chạy backend ngoài docker)
#DB_HOST=localhost
#DB_PORT=5432

# -------------------------- Redis ---------------------------
REDIS_PASSWORD=change_me_redis_password
#REDIS_HOST=localhost
#REDIS_PORT=6379

# --------------------- Mail (Gmail SMTP) --------------------
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password   # Google App Password (16 ký tự)
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587

# --------------------------- JWT ----------------------------
# Tạo bằng: openssl rand -base64 48
JWT_SIGNER_KEY=your_jwt_signer_key_base64
#JWT_ACCESS_DURATION=3600      # seconds (1 hour)
#JWT_REFRESH_DURATION=2592000  # seconds (30 days)

# ------------------------ Cloudinary ------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------ payOS Payment Gateway -------------------
# my.payos.vn → Kênh thanh toán → Thông tin tích hợp
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
#PAYOS_RETURN_URL=http://localhost:3000/
#PAYOS_CANCEL_URL=http://localhost:3000/
#PAYOS_LINK_EXPIRY_MINUTES=15

# --------------------- Google OAuth2 ------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
#GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

#ADMIN_USERNAME=admin
ADMIN_PASSWORD=
#ADMIN_EMAIL=admin@gmail.com

# ============================================================
# FRONTEND (Vite) — ĐỌC CHUNG TỪ FILE NÀY
#
# ⚠️ Mọi biến có tiền tố VITE_ đều bị nhúng CỨNG vào bundle JavaScript và gửi
#    tới TRÌNH DUYỆT của mọi người dùng. Chúng KHÔNG phải bí mật.
#
#    Các biến phía trên (POSTGRES_*, JWT_SIGNER_KEY, GOOGLE_CLIENT_SECRET, ...)
#    không có tiền tố nên Vite không bao giờ đụng tới — đó là lý do để chung
#    một file vẫn an toàn.
#
#    => TUYỆT ĐỐI không đặt tiền tố VITE_ cho một secret. Đó là ranh giới duy
#       nhất giữa file này và trình duyệt người dùng.
#
# GOOGLE_CLIENT_ID lặp lại bản không-VITE_ ở trên. Cố ý để cạnh nhau cho dễ
# giữ đồng bộ — trước đây chúng nằm ở hai file khác nhau và đã lệch nhau thật.
# ============================================================
VITE_API_BASE_URL=/api/v1
# Để trống thì tự suy ra từ VITE_API_BASE_URL + origin hiện tại
# VITE_WS_URL=

# Lấy ở Google Cloud Console → Credentials. Không còn giá trị mặc định trong
# code: thiếu biến này thì nút đăng nhập Google không chạy và console báo rõ.
VITE_GOOGLE_CLIENT_ID=
# Để trống thì mặc định là <origin>/auth/google/callback
# VITE_GOOGLE_REDIRECT_URI=

# Cloudinary KHÔNG còn biến VITE_* nào. Upload ảnh đi qua backend
# (POST /images/upload); secret nằm ở CLOUDINARY_* phía trên, chỉ backend đọc.

# Thông tin công ty (hotline, email, địa chỉ, giờ làm việc) KHÔNG nằm ở đây nữa.
# Nó là nội dung tĩnh, không phải bí mật và không đổi theo môi trường
# -> frontend/src/constants/company.ts
