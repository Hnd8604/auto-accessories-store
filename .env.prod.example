# ==============================================================
# Biến môi trường cho bản deploy trên VPS.
# Trên server: copy thành .env.prod, đặt CẠNH docker-compose.prod.yml.
#   cp .env.prod.example .env.prod && nano .env.prod
#
# ⚠️ ĐỔI TÊN: trước đây file này copy thành `.env`. Nay là `.env.prod` cho đối
#    xứng với `.env.dev` của máy local. Trên VPS đang chạy phải làm MỘT LẦN:
#      mv .env .env.prod
#    Bước deploy trong CD sẽ dừng lại và nhắc nếu bạn quên.
#
# Server chỉ cần đúng 2 file: docker-compose.prod.yml và .env.prod
# TUYỆT ĐỐI không commit .env.prod chứa giá trị thật.
# ==============================================================

# ------------------------ Image / Deploy --------------------
# Khớp với tên repo GitHub, image do workflow CD đẩy lên ghcr.io
IMAGE_OWNER=hnd8604/auto-accessories-store
IMAGE_TAG=latest

# ------------------------ Domain / TLS ----------------------
# Bản ghi A của domain này PHẢI trỏ đúng IP VPS trước khi `up`,
# nếu không certbot sẽ không xin được chứng chỉ.
APP_DOMAIN=trungduongauto.store
# Email nhận cảnh báo từ Let's Encrypt khi chứng chỉ sắp hết hạn
ACME_EMAIL=you@example.com

# ------------------------ PostgreSQL ------------------------
POSTGRES_DB=store
POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me_db_password

# -------------------------- Redis ---------------------------
REDIS_PASSWORD=change_me_redis_password


# --------------------- Mail (Gmail SMTP) --------------------
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# --------------------------- JWT ----------------------------
# Tạo bằng: openssl rand -base64 48
JWT_SIGNER_KEY=your_jwt_signer_key_base64

# ------------------------ Cloudinary ------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------ SePay Payment Gateway -------------------
SEPAY_API_KEY=your_sepay_api_key
SEPAY_BANK_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_ACCOUNT_NAME=NGUYEN VAN A
#SEPAY_BANK_CODE=MBBank
#SEPAY_BANK_NAME=MB Bank

# --------------------- Google OAuth2 ------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Phải khớp CHÍNH XÁC với Authorized redirect URI khai trong Google
# Cloud Console, và khớp domain ở trên.
GOOGLE_REDIRECT_URI=https://trungduongauto.store/auth/google/callback

# --------------------- Admin khởi tạo -----------------------
# BẮT BUỘC ở lần deploy đầu tiên (database còn rỗng), nếu thiếu backend
# sẽ không khởi động. Các lần deploy sau tài khoản đã tồn tại nên biến
# này bị bỏ qua.
ADMIN_PASSWORD=
#ADMIN_USERNAME=admin
#ADMIN_EMAIL=admin@gmail.com
